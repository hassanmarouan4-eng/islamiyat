{
  "name": "islamiyat",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  "kv_namespaces": [
    { "binding": "DB" }
  ],
  // مكتبة الملفات الجاهزة (library/): لا تُخدم مباشرة، بل يقرؤها الـ Worker ويحميها بالاشتراك
  "assets": { "directory": "library", "binding": "ASSETS", "run_worker_first": true }
}
